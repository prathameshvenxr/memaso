{
  "extract": {
    "title": "extract",
    "type": "object",
    "required": ["memories"],
    "additionalProperties": false,
    "properties": {
      "memories": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["text", "kind"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "kind": {"type": "string", "enum": ["fact", "preference", "decision", "episode", "procedure", "relationship"]},
            "entities": {"type": "array", "items": {"type": "string"}},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "valid_from": {"type": ["string", "null"]}
          }
        }
      }
    }
  },
  "judge": {
    "title": "judge",
    "type": "object",
    "required": ["verdict"],
    "additionalProperties": false,
    "properties": {
      "verdict": {"type": "string", "enum": ["new", "duplicate", "updates", "contradicts"]},
      "target_id": {"type": ["string", "null"]},
      "reason": {"type": "string"}
    }
  }
}
